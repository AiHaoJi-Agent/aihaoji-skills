{
  "name": "aihaoji-openclaw",
  "version": "0.1.0",
  "description": "Ai好记 Skill — 搜索、读取、导出、整理 AI好记笔记，支持笔记本管理、笔记移动、划线批注和我的记录。",
  "license": "MIT",
  "author": "aihaoji",
  "homepage": "https://aihaoji.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/AiHaoJi-Agent/aihaoji-skills.git"
  },
  "keywords": [
    "Ai好记",
    "aihaoji",
    "notes",
    "知识库",
    "语义搜索",
    "笔记详情",
    "笔记本管理",
    "笔记整理",
    "批注",
    "openclaw",
    "skill"
  ],
  "clawhub": {
    "acceptLicenseTerms": true
  },
  "openclaw": {
    "minVersion": "0.1.0",
    "baseUrl": "https://openapi.aihaoji.com",
    "requires": {},
    "optionalEnv": [
      "AIHAOJI_API_KEY"
    ]
  },
  "bin": {
    "aihaoji-openclaw": "./scripts/install.mjs"
  },
  "scripts": {
    "setup": "node ./scripts/install.mjs setup",
    "install": "node ./scripts/install.mjs install",
    "check": "python3 scripts/check_aihaoji.py",
    "check:docs": "python3 scripts/check_skill_docs.py",
    "test": "python3 -m pytest tests",
    "install:local": "python3 scripts/install_aihaoji.py"
  }
}
