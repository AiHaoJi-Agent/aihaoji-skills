{
  "name": "aihaoji-skills",
  "version": "1.0.0",
  "description": "Ai好记 Skill — 搜索、读取、导出、创建、整理 AI好记笔记，支持 Markdown 写入、笔记本管理、笔记移动、查看划线批注和我的记录。",
  "license": "MIT-0",
  "author": "aihaoji",
  "homepage": "https://aihaoji.com/zh/skill",
  "repository": {
    "type": "git",
    "url": "https://github.com/AiHaoJi-Agent/aihaoji-skills.git"
  },
  "files": [
    "README.md",
    "LICENSE",
    "skills/aihaoji/SKILL.md",
    "skills/aihaoji/agents/",
    "skills/aihaoji/references/",
    "skills/aihaoji/scripts/check_aihaoji.py",
    "skills/aihaoji/scripts/install_aihaoji.py",
    "skills/aihaoji/scripts/install.mjs"
  ],
  "keywords": [
    "Ai好记",
    "aihaoji",
    "notes",
    "知识库",
    "语义搜索",
    "笔记详情",
    "笔记本管理",
    "笔记整理",
    "批注",
    "agent-skills",
    "codex",
    "openclaw",
    "claude-code",
    "hermes-agent",
    "skill"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "aihaoji-skills": "./skills/aihaoji/scripts/install.mjs"
  },
  "scripts": {
    "setup": "node ./skills/aihaoji/scripts/install.mjs setup",
    "check": "python3 skills/aihaoji/scripts/check_aihaoji.py",
    "check:create": "python3 skills/aihaoji/scripts/check_aihaoji.py --create-probe",
    "test": "python3 -m pytest tests && node --test tests/*.test.mjs",
    "install:local": "python3 skills/aihaoji/scripts/install_aihaoji.py",
    "validate:skill": "node scripts/validate_skill.mjs"
  }
}
